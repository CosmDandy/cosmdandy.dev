# Caching of static files. By default Cloudflare Workers serves everything
# with max-age=0, must-revalidate: a repeat visit asks about every file again
# and gets a 304. The body is not sent then, so this is only expensive for
# large files that are known not to change — that is, for the fonts.
#
# Everything else is deliberately missing here: style.css, the icons and og.png
# live under permanent names, and immutable would mean a change never reaching
# anyone who has opened the site before. ETag revalidation is both cheaper and
# more honest for them.
#
# The file is copied into _site/ by the build step in
# .github/workflows/deploy.yaml.

# Стили и скрипт: ссылка на них несёт версию — `?v=<хэш содержимого>`, — и
# поэтому кэшировать их можно навсегда. Поменялся файл, поменялся хэш, у
# браузера это другой адрес, которого он ещё не видел. Не поменялся — берётся
# из кэша, не спрашивая: до этой правки на каждый повторный заход приходилось
# четыре условных запроса, и два из них до первого кадра.
#
# Голый адрес без версии тоже попадает под правило, и это безопасно: браузер
# кэширует по полному адресу, и версионированный ключ с ним не пересекается.
# А страница переспрашивается всегда и всегда несёт текущий хэш.
/style.css
  Cache-Control: public, max-age=31536000, immutable

/server.css
  Cache-Control: public, max-age=31536000, immutable

/server.js
  Cache-Control: public, max-age=31536000, immutable

/tg/style.css
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Board revisions: the file name carries the commit hash, so the contents never
# change — a new revision arrives under a new name. Отсюда immutable: однажды
# скачанную схему перепроверять незачем, а ленту листают вперёд-назад по одним
# и тем же файлам, и на второй проход каждая должна браться из кэша.
/history/*.svg
  Cache-Control: public, max-age=31536000, immutable

# CSP:BEGIN
# Сгенерировано tools/csp.py по собранным страницам — правится там, а не здесь.
# Хэши перечисляют встроенные скрипты поимённо: любой другой браузер выполнять
# откажется. Считать их надо после минификации, иначе они не от тех тел.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-060CGAjRay2CwqTWYAPE1thtjjYZIFk8U6U3FsvPzd4=' 'sha256-EslpH1HwOhX7CxcW9x8NKQChSMnppMS2I0E4v1sAlDA=' 'sha256-F+1f6ja19n+VltT5nZR5eJNNk9gfTIcXu39GqsAz3YM=' 'sha256-LDuMXSkQ4ccPZFMjNf8+P+kWttGBOQHCSTnWhP3W20k=' 'sha256-TNaTK80SuNBHU2/jkMMc/MIICB7kROo6Blljshzccys=' 'sha256-TVg2f/ZTMYcJ/XnLZYw3wHqLzkiaes3wQbMlDGhqG8I=' 'sha256-bawlkInkK3hSX0FDLeHdQRMfK7k9/KAmiF62PjjaOLY=' 'sha256-jOkqQ05xINdH10Z6kNaUXw1yKnNxeU+i9LcUj1T14s8=' 'sha256-l6S+Jzzei+tdPLONrFgsce2+TihI09GpqSYyndxty7s=' 'sha256-pymAwj0Nv8ZrHg/OSdTibjeNgE44XFu0mJptuvUIN7Y=' 'sha256-xvzSCqkREpS17s934zUIGI9aZzl8UcA3W1Q2JGn+1SY='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'
  # Первый заход по http можно перехватить; после него браузер год ходит
  # только по https, не спрашивая.
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # Без него браузер угадывает тип файла по содержимому и может выполнить
  # картинку как скрипт.
  X-Content-Type-Options: nosniff
  # По умолчанию на чужой сайт уезжает полный адрес страницы, с которой ушли.
  # Здесь уедет только имя домена, и только по https.
  Referrer-Policy: strict-origin-when-cross-origin
  # Ничего из этого сайту не нужно, и просить это от его имени не должен никто.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  # Вкладка изолируется от той, что её открыла.
  Cross-Origin-Opener-Policy: same-origin
# CSP:END
