# Caching of static files. By default Cloudflare Workers serves everything
# with max-age=0, must-revalidate: a repeat visit asks about every file again
# and gets a 304. The body is not sent then, so this is only expensive for
# large files that are known not to change — that is, for the fonts.
#
# Everything else is deliberately missing here: style.css, the icons and og.png
# live under permanent names, and immutable would mean a change never reaching
# anyone who has opened the site before. ETag revalidation is both cheaper and
# more honest for them.
#
# The file is copied into _site/ by the build step in
# .github/workflows/deploy.yaml.

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Board revisions: the file name carries the commit hash, so the contents never
# change — a new revision arrives under a new name. Отсюда immutable: однажды
# скачанную схему перепроверять незачем, а ленту листают вперёд-назад по одним
# и тем же файлам, и на второй проход каждая должна браться из кэша.
/history/*.svg
  Cache-Control: public, max-age=31536000, immutable
