// Static files on Cloudflare Workers, with a thin worker in front of the pages.
//
// Why Workers and not Pages: since 2025 Cloudflare takes new projects here,
// and Pages gets fixes only.
//
// We serve _site/ rather than the repository root: otherwise README, .github
// and this very config would go out with the site.
{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "cosmdandy-dev",
  "compatibility_date": "2026-07-29",
  "main": "./worker.js",
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Воркер встаёт перед страницами и перед приёмом мерок — и больше нигде.
    // Файлы едут мимо него напрямую: им он не нужен ничем, а лишний вызов на
    // каждый шрифт и каждую ревизию схемы — это плата ни за что.
    //
    // Страницам он нужен ради метки версии: механизм раздачи файлов не ставит
    // на HTML ни ETag, ни Last-Modified, и обещанное заголовком
    // `must-revalidate` исполнить нечем — каждый повторный заход везёт всю
    // страницу заново.
    "run_worker_first": ["/", "/index.html", "/404.html", "/tg", "/tg/", "/tg/index.html", "/rum"]
  },

  // Версия сборки — она же метка страницы. Считать метку от тела нельзя: тело
  // это мегабайт разметки, и хэшировать его на каждый запрос дороже, чем
  // отдать. Версия меняется ровно при выкатке.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  // Мерки от живых гостей падают сюда же, в журнал воркера: `wrangler tail`
  // и панель Logs. Отдельное хранилище под них не заводится нарочно — вопрос
  // к ним не «сколько их всего», а «стало ли хуже после выкатки», и на него
  // отвечает лента последних записей.
  //
  // Если понадобятся агрегаты за месяц, сюда добавляется Analytics Engine:
  //   "analytics_engine_datasets": [{ "binding": "RUM", "dataset": "rum" }]
  // и в worker.js — env.RUM.writeDataPoint(...). Пока это лишняя сущность.
  "observability": {
    "enabled": true
  }
}
