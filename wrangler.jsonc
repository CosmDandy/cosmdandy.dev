// Static files on Cloudflare Workers. There is no worker script — file
// serving only.
//
// Why Workers and not Pages: since 2025 Cloudflare takes new projects here,
// and Pages gets fixes only.
//
// We serve _site/ rather than the repository root: otherwise README, .github
// and this very config would go out with the site.
{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "cosmdandy-dev",
  "compatibility_date": "2026-07-29",
  "assets": {
    "directory": "./_site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
